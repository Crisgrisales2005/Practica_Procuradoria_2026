# === Servicio web (Render / docker compose web) ===
DATABASE_URL=
# Frase larga de varias palabras (no un PIN). Obligatoria en la web.
APP_PASSWORD=
# Secreto de cookie de sesión (largo y aleatorio). En Render se puede generar.
SESSION_SECRET=
# 1 en producción HTTPS (cookie Secure); 0 en local http://localhost.
# En Render: SESSION_HTTPS_ONLY=1 (también lo fija el Dockerfile).
SESSION_HTTPS_ONLY=0

# Tras migrate_fase9_web.sql, DATABASE_URL de Render debe ser el rol:
#   postgresql://procuradoria_web.<project_ref>:<password>@….pooler.supabase.com:5432/postgres
# Para tests E2E del rol (opcional):
# DATABASE_URL_WEB=

# === Solo administración local (ingesta / Gemini / RAG) ===
GOOGLE_API_KEY=
GENERATION_PROVIDER=gemini
OLLAMA_BASE_URL=http://host.docker.internal:11434
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
CHROMA_COLLECTION=pgn_articulos
RAG_MIN_SCORE=0.35
